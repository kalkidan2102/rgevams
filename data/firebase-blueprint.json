        "description": { "type": "string" }
      },
      "required": ["name", "location"]
    },
    "users": {
      "title": "User Accounts",
      "description": "Registered institute personnel, staff, and officials",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
