{
  "entities": {
    "earthquakes": {
      "title": "Earthquakes",
      "description": "Seismic event catalog monitored by SSGI",
      "properties": {
        "magnitude": { "type": "number" },
        "location": { "type": "string" },
        "coordinates": { "type": "array" },
        "depth": { "type": "number" },
        "dateTime": { "type": "string" },
        "severity": { "type": "string" },
        "description": { "type": "string" },
        "isHistorical": { "type": "boolean" }
      },
      "required": ["magnitude", "location", "dateTime", "severity"]
    },
    "volcanoes": {
      "title": "Volcanoes",
      "description": "Volcanic alert and activity tracking catalog",
      "properties": {
        "name": { "type": "string" },
        "region": { "type": "string" },
        "elevation": { "type": "number" },
        "coordinates": { "type": "array" },
        "type": { "type": "string" },
        "activityType": { "type": "string" },
        "severity": { "type": "string" },
        "lastErupted": { "type": "string" },
        "description": { "type": "string" },
        "monitoredBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "region", "severity"]
    },
    "gnss_stations": {
      "title": "GNSS Stations",
      "description": "Geodetic station crustal velocity measurements",
      "properties": {
        "name": { "type": "string" },
        "location": { "type": "string" },
        "coordinates": { "type": "array" },
        "velocityNorth": { "type": "number" },
