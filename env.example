# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: (Optional) Specify which Gemini model to use:
GEMINI_MODEL="gemini-2.5-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ===================================================================
# POSTGRESQL + POSTGIS CONFIGURATION (R-GEVAMS)
# ===================================================================
SQL_HOST="localhost"
SQL_PORT="5432"
SQL_USER="postgres"
SQL_PASSWORD="REPLACE_WITH_DATABASE_PASSWORD"
SQL_DB_NAME="rgevams"

# Optional unified connection string:
DATABASE_URL="postgresql://postgres:<password>@localhost:5432/rgevams"

# JWT Authentication Secret Key
JWT_SECRET="REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"

# ===================================================================
# EMERGENCY OFFICIAL ALERT EMAIL RELAY (SMTP / NODEMAILER)
# ===================================================================
# Configure these variables to dispatch real emergency emails to officials:
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ethiopian Space Science and Geospatial Institute <alerts@ssgi.gov.et>"


